          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "SELECT sum(\"count\") FROM \"virtual_service\" WHERE $timeFilter AND \"runId\" =~ /^${runId:regex}$/ AND \"service\" = 'unmatched' GROUP BY time($__interval) fill(0)",
          "rawQuery": true,
          "resultFormat": "time_series",
          "alias": "unmatched",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          }
        }
      ]
    }
  ]
}
